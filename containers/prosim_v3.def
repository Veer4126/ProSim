Bootstrap: docker
From: ubuntu:22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        wget \
        git \
        build-essential \
        curl \
        ca-certificates \
        libgl1 \
        libglib2.0-0
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    #
    # Install Miniconda
    #
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh
    export PATH=/opt/conda/bin:$PATH

    #
    # Create ProSim environment (python 3.8, per ProSim's requirement)
    # Use conda-forge to avoid Anaconda's default-channel ToS gate
    #
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
    conda config --remove channels-key channels || true
    conda config --add channels conda-forge
    conda create -y -n prosim python=3.8 pip
    . /opt/conda/etc/profile.d/conda.sh
    conda activate prosim
    python -m pip install --upgrade pip

    #
    # 1. Main pinned block: core stack + ProSim deps + torch-cluster/torch_geometric
    #
    pip install \
        numpy==1.21.5 \
        scipy==1.9.1 \
        scikit-image==0.20.0 \
        pandas==1.5.3 \
        matplotlib==3.6.1 \
        seaborn==0.11.2 \
        pyarrow==10.0.0 \
        zarr==2.13.3 \
        geopandas==0.13.2 \
        opencv-python-headless==4.8.0.74 \
        torch==2.4.0 \
        torchvision==0.19.0 \
        torchaudio==2.4.0 \
        pytorch-lightning==2.0.8 \
        torchmetrics==1.4.0.post0 \
        transformers==4.37.2 \
        intervaltree==3.2.1 \
        yacs==0.1.8 \
        peft==0.13.2 \
        simplification==0.7.12 \
        huggingface-hub==0.36.2 \
        wandb==0.24.2 \
        ipykernel==6.29.5 \
        tensorboard==2.11.2 \
        kornia==0.7.3

    pip install torch-geometric==2.6.1
    pip install torch-cluster==1.6.3 -f https://data.pyg.org/whl/torch-2.4.0+cpu.html

    #
    # 2. Waymo Open Dataset devkit (pulls in TensorFlow 2.11 + its own pinned deps)
    #
    pip install waymo-open-dataset-tf-2-11-0==1.6.1

    #
    # 3. Trajdata, installed WITHOUT deps to avoid its seaborn>=0.12 / matplotlib>=3.5
    #    floors clobbering the pins above (seaborn>=0.12 explicitly excludes
    #    matplotlib==3.6.1, which waymo above hard-requires)
    #
    pip install --no-deps \
        git+https://github.com/Ariostgx/trajdata.git@80c79e23cfddb10074e1d1a0442451614d40913f#egg=trajdata

    #
    # 4. Trajdata's real extra runtime deps not already covered above
    #
    pip install \
        dill==0.4.0 \
        bokeh==3.1.1 \
        xyzservices==2026.3.0

    #
    # 5. Re-pin matplotlib/seaborn in case step 4 bumped them again
    #
    pip install matplotlib==3.6.1 seaborn==0.11.2

%environment
    export PATH=/opt/conda/bin:$PATH
    . /opt/conda/etc/profile.d/conda.sh
    conda activate prosim
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1

%runscript
    . /opt/conda/etc/profile.d/conda.sh
    conda activate prosim
    exec python "$@"
